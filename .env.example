# Optional online sandbox providers. Tier0 works without either key.
URLSCAN_API_KEY=
URLSCAN_VISIBILITY=unlisted
URLSCAN_MAX_WAIT_MS=24000
VIRUSTOTAL_API_KEY=

# Optional Supabase RAG. Without these values the bundled case index is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional LLM provider retained for later agent extensions.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional web search for the AI assistant's live internet lookup.
# 二选一即可：博查（国内友好，推荐）或 Tavily（国际）。
BOCHA_API_KEY=
TAVILY_API_KEY=

# Optional local Chrome screenshot fallback. Set to 0 to disable.
SAFEAGENT_LOCAL_SCREENSHOT=1
CHROME_EXECUTABLE_PATH=

