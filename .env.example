# Optional online sandbox providers. Tier0 works without either key.
URLSCAN_API_KEY=
URLSCAN_VISIBILITY=unlisted
URLSCAN_MAX_WAIT_MS=24000
VIRUSTOTAL_API_KEY=

# Optional Supabase RAG. Without these values the bundled case index is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional LLM provider retained for later agent extensions.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional web search for the AI assistant's live internet lookup.
# 使用 DeepSeek 官方搜索接口（复用 DEEPSEEK_API_KEY，无需额外配置）。

# Optional local Chrome screenshot fallback. Set to 0 to disable.
SAFEAGENT_LOCAL_SCREENSHOT=1
CHROME_EXECUTABLE_PATH=

# Remote page screenshot fallback for deployments without Chrome.
# THUM.io is used by default. Set to 0 to disable external screenshot generation.
SAFEAGENT_REMOTE_SCREENSHOT=1
# Optional custom image URL template. Supports {url}, {encodedUrl}, or {rawUrl}.
SCREENSHOT_SERVICE_URL=


# Screenshot recognition. Set VISION_MODEL to an image-capable Chat Completions model.
# Leave both VISION_BASE_URL and VISION_API_KEY empty to reuse the configured DEEPSEEK provider.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
